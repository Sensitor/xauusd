# =====================================================================
# GoldMind AI — environment template.
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
# All keys are read by goldmind.config.Settings (pydantic-settings).
# =====================================================================

# ---- Runtime mode ----------------------------------------------------
# environment: dev | staging | prod
GOLDMIND_ENVIRONMENT=dev
# execution_mode: shadow | semi_auto | full_auto
#   shadow    -> agents run, decisions logged, NO orders sent
#   semi_auto -> decisions require human approval before execution
#   full_auto -> approved decisions are executed automatically
GOLDMIND_EXECUTION_MODE=shadow
GOLDMIND_LOG_LEVEL=INFO

# ---- LLM providers ---------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Default models per role (override per-agent in config if needed)
GOLDMIND_REASONING_MODEL=claude-sonnet-4-6
GOLDMIND_VISION_MODEL=gpt-4o
GOLDMIND_FAST_MODEL=claude-haiku-4-5-20251001

# ---- Database --------------------------------------------------------
# psycopg3 URL form. Compose service name is `postgres`.
GOLDMIND_DATABASE_URL=postgresql+psycopg://goldmind:goldmind@localhost:5432/goldmind

# ---- MetaTrader 5 (execution node only) ------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_SYMBOL=XAUUSD

# ---- Market / news data feeds ---------------------------------------
# Optional API keys for macro & news ingestion (free tiers exist).
FRED_API_KEY=
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
FOREXFACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# ---- Risk limits (can also be set in config.py defaults) -------------
GOLDMIND_RISK__MAX_RISK_PER_TRADE=0.005       # 0.5% of equity per trade
GOLDMIND_RISK__MAX_DAILY_DRAWDOWN=0.02        # 2% daily circuit breaker
GOLDMIND_RISK__MAX_TOTAL_DRAWDOWN=0.06        # 6% account stop (prop-firm style)
GOLDMIND_RISK__MAX_CONSECUTIVE_LOSSES=3
GOLDMIND_RISK__MAX_TRADES_PER_DAY=5
GOLDMIND_RISK__MIN_REWARD_RISK=1.8

# ---- Observability ---------------------------------------------------
PROMETHEUS_PORT=9000
